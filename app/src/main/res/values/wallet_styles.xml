<resources>
    <style name="ShapeAppearance.WalletTracker.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">16dp</item>
    </style>
    <style name="ShapeAppearance.WalletTracker.Large" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="Widget.WalletTracker.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.WalletTracker.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">18dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.WalletTracker.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.WalletTracker.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
    </style>
    <style name="Theme.WalletTracker.PaletteBase" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/wallet_primary</item>
        <item name="colorOnPrimary">@color/wallet_on_primary</item>
        <item name="colorPrimaryContainer">@color/wallet_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/wallet_on_primary_container</item>
        <item name="colorSecondary">@color/wallet_secondary</item>
        <item name="colorOnSecondary">@color/wallet_on_secondary</item>
        <item name="colorSecondaryContainer">@color/wallet_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/wallet_on_secondary_container</item>
        <item name="colorTertiary">@color/wallet_tertiary</item>
        <item name="colorOnTertiary">@color/wallet_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/wallet_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/wallet_on_tertiary_container</item>
        <item name="android:colorBackground">@color/wallet_surface</item>
        <item name="android:windowBackground">@color/wallet_surface</item>
        <item name="colorSurface">@color/wallet_surface</item>
        <item name="colorSurfaceContainerLowest">@color/wallet_surface_low</item>
        <item name="colorSurfaceContainerLow">@color/wallet_surface_low</item>
        <item name="colorSurfaceContainer">@color/wallet_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/wallet_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/wallet_surface_high</item>
        <item name="colorSurfaceVariant">@color/wallet_surface_variant</item>
        <item name="colorOnSurface">@color/wallet_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/wallet_on_surface_variant</item>
        <item name="colorOutline">@color/wallet_outline</item>
        <item name="colorOutlineVariant">@color/wallet_outline_variant</item>
        <item name="colorError">@color/wallet_error</item>
        <item name="colorOnError">@color/wallet_on_error</item>
        <item name="colorErrorContainer">@color/wallet_error_container</item>
        <item name="colorOnErrorContainer">@color/wallet_on_error_container</item>
        <item name="materialButtonStyle">@style/Widget.WalletTracker.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.WalletTracker.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.WalletTracker.Button.Text</item>
        <item name="textInputStyle">@style/Widget.WalletTracker.TextInput</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.WalletTracker.Medium</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.WalletTracker.Large</item>
    </style>
</resources>
